# AI provider
GROQ_API_KEY=your_groq_api_key_here

# Memory provider: cloud or local
MEMORY_PROVIDER=cloud
FRIDAY_USER_ID=your_user_id_here

# Supabase cloud memory
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
MEMORY_TABLE=memories

# Device server
FRIDAY_DEVICE_SERVER_PORT=3030
FRIDAY_DEVICE_ENROLLMENT_TOKEN=replace_with_a_long_random_enrollment_token

# Disable OpenAI Agents tracing for the Groq setup
OPENAI_AGENTS_DISABLE_TRACING=1
