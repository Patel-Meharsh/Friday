# AI provider
GROQ_API_KEY=your_groq_api_key_here

# Memory provider: cloud or local
MEMORY_PROVIDER=cloud
FRIDAY_USER_ID=your_user_id_here

# Supabase cloud memory
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
MEMORY_TABLE=memories

# Natural neural voice (server-side only; never expose the API key to the browser)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
FRIDAY_TTS_VOICE_ID=your_elevenlabs_voice_id_here
FRIDAY_TTS_MODEL_ID=eleven_flash_v2_5

# Device server
FRIDAY_DEVICE_SERVER_PORT=3030
FRIDAY_DEVICE_ENROLLMENT_TOKEN=replace_with_a_long_random_enrollment_token

# Disable OpenAI Agents tracing for the Groq setup
OPENAI_AGENTS_DISABLE_TRACING=1
