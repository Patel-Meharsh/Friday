# AI provider
GROQ_API_KEY=your_groq_api_key_here

# Memory provider: local or cloud
MEMORY_PROVIDER=local

# Used by the cloud memory adapter to separate one user's memory from another's
FRIDAY_USER_ID=your_user_id_here

# Supabase cloud memory (only required when MEMORY_PROVIDER=cloud)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Disable OpenAI Agents tracing for the Groq setup
OPENAI_AGENTS_DISABLE_TRACING=1
